<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\AuthorApplication;
use App\Models\BlogPost;
use App\Models\Category;
use App\Models\Comment;
use App\Models\CryptoCoin;
use App\Models\CryptoPrice;
use App\Models\News;
use App\Models\User;
use Illuminate\Support\Collection;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Illuminate\View\View;

class DashboardController extends Controller
{
    public function index(): View
    {
        $pendingAuthorApplications = AuthorApplication::query()
            ->whereRaw('LOWER(status) = ?', ['pending'])
            ->count();

        $approvedAuthorApplications = AuthorApplication::query()
            ->whereRaw('LOWER(status) = ?', ['approved'])
            ->count();

        $rejectedAuthorApplications = AuthorApplication::query()
            ->whereRaw('LOWER(status) = ?', ['rejected'])
            ->count();

        $totalAuthorApplications = AuthorApplication::query()->count();

        $pendingBlogPosts = BlogPost::query()
            ->whereRaw('LOWER(status) = ?', ['pending'])
            ->count();

        $approvedBlogPosts = BlogPost::query()
            ->whereRaw('LOWER(status) = ?', ['approved'])
            ->count();

        $rejectedBlogPosts = BlogPost::query()
            ->whereRaw('LOWER(status) = ?', ['rejected'])
            ->count();

        $totalBlogPosts = BlogPost::query()->count();

        $totalUsers = User::query()->count();

        /*
         * Đếm role theo cả 2 kiểu:
         * - users.role
         * - roles + role_user
         *
         * Lý do: trong quá trình phát triển project đã từng dùng cả 2 cách,
         * nên nếu chỉ đếm một nguồn thì dashboard dễ bị hiện 0 sai.
         */
        $totalAuthors = $this->countUsersByRole('AUTHOR');
        $totalAdmins = $this->countUsersByRole('ADMIN');

        $totalComments = Comment::query()->count();

        $totalNews = News::query()->count();
        $totalCategories = Category::query()->count();
        $totalCoins = CryptoCoin::query()->count();

        $latestCryptoUpdate = CryptoPrice::query()
            ->latest('updated_at')
            ->value('updated_at');

        return view('admin.dashboard', [
            'pendingAuthorApplications' => $pendingAuthorApplications,
            'approvedAuthorApplications' => $approvedAuthorApplications,
            'rejectedAuthorApplications' => $rejectedAuthorApplications,
            'totalAuthorApplications' => $totalAuthorApplications,

            'pendingBlogPosts' => $pendingBlogPosts,
            'approvedBlogPosts' => $approvedBlogPosts,
            'rejectedBlogPosts' => $rejectedBlogPosts,
            'totalBlogPosts' => $totalBlogPosts,

            'totalUsers' => $totalUsers,
            'totalAuthors' => $totalAuthors,
            'totalAdmins' => $totalAdmins,
            'totalComments' => $totalComments,

            'totalNews' => $totalNews,
            'totalCategories' => $totalCategories,
            'totalCoins' => $totalCoins,
            'latestCryptoUpdate' => $latestCryptoUpdate,
        ]);
    }

    private function countUsersByRole(string $role): int
    {
        $role = strtoupper($role);

        $userIds = collect();

        if (Schema::hasColumn('users', 'role')) {
            $idsFromUsersTable = DB::table('users')
                ->whereRaw('UPPER(role) = ?', [$role])
                ->pluck('id');

            $userIds = $userIds->merge($idsFromUsersTable);
        }

        if (
            Schema::hasTable('roles') &&
            Schema::hasTable('role_user') &&
            Schema::hasColumn('roles', 'id') &&
            Schema::hasColumn('roles', 'name') &&
            Schema::hasColumn('role_user', 'user_id') &&
            Schema::hasColumn('role_user', 'role_id')
        ) {
            $idsFromPivotTable = DB::table('users')
                ->join('role_user', 'users.id', '=', 'role_user.user_id')
                ->join('roles', 'roles.id', '=', 'role_user.role_id')
                ->whereRaw('UPPER(roles.name) = ?', [$role])
                ->pluck('users.id');

            $userIds = $userIds->merge($idsFromPivotTable);
        }

        return $userIds
            ->filter()
            ->unique()
            ->count();
    }
}